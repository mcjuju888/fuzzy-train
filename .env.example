# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-only — never prefix this with NEXT_PUBLIC_.
# Every write to the shared cache (opponents/games/reports) goes through it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the magic-link redirect. On Vercel this can be left unset and
# VERCEL_URL is used instead; set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How long a cached dossier stays fresh before a read triggers a re-sync.
SCOUT_CACHE_TTL_HOURS=24

# Hard ceiling on how many games a single sync will pull per platform.
SCOUT_MAX_GAMES=600

# Shared secret for the Vercel Cron refresh endpoint. Vercel sends its own
# Authorization: Bearer $CRON_SECRET header when this is set in the project.
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Upstream chess APIs
# ---------------------------------------------------------------------------
# Chess.com blocks requests without a descriptive User-Agent. Put a real
# contact address here — they ask for one.
CHESS_USER_AGENT=gambit-file/0.1 (+mailto:you@example.com)

# Optional. A Lichess personal access token raises the rate limit ceiling;
# the fetcher works unauthenticated too, just more slowly.
LICHESS_TOKEN=
